{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: GDB Depurar Projeto",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/a.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
