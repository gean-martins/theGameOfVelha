            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Habilitar impressão formatada para gdb",
                    "text": "-enable-pretty-printing",
                    "ignore": true
                }
            ],
            "preLaunchTask": "C/C++: gcc build multi-arquivo"
        }
    ]
}
